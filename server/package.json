{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:status": "node scripts/prisma-safe-command.cjs status",
    "db:migrate:deploy": "node scripts/prisma-safe-command.cjs deploy",
    "db:migrate:dev": "node scripts/prisma-safe-command.cjs dev",
    "db:seed": "node scripts/prisma-safe-command.cjs seed",
    "release:database": "npm run db:validate && npm run db:migrate:deploy && npm run db:migrate:status",
    "prisma:generate": "npm run db:generate",
    "prisma:migrate:deploy": "npm run db:migrate:deploy",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:db-safety": "node --test scripts/prisma-safe-command.test.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}

# Frontend runtime. Production must use PRODUCTION_SERVER and a real backend.
NEXT_PUBLIC_RUNTIME_MODE=DEMO_LOCAL
NEXT_PUBLIC_BASE_PATH=/workspace
# NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api

# Public capability declarations. These are diagnostics only and never grant access.
NEXT_PUBLIC_AUTH_ADAPTER_READY=false
NEXT_PUBLIC_PROJECT_ADAPTER_READY=false
NEXT_PUBLIC_DRIVE_ADAPTER_READY=false
NEXT_PUBLIC_DRIVE_PROVIDER_READY=false
NEXT_PUBLIC_APPROVAL_ADAPTER_READY=false
NEXT_PUBLIC_APPROVAL_POLICY_READY=false
NEXT_PUBLIC_APPROVAL_SERVER_READY=false
NEXT_PUBLIC_MAIL_ADAPTER_READY=false
NEXT_PUBLIC_MAIL_PROVIDER_READY=false
NEXT_PUBLIC_BUSINESS_CARD_ADAPTER_READY=false
NEXT_PUBLIC_BUSINESS_CARD_OCR_PROVIDER_READY=false
NEXT_PUBLIC_SALES_ADAPTER_READY=false
NEXT_PUBLIC_FINANCE_ADAPTER_READY=false
NEXT_PUBLIC_CLAIM_ADAPTER_READY=false
NEXT_PUBLIC_AI_ADAPTER_READY=false
NEXT_PUBLIC_AI_PROVIDER_READY=false

# Optional public health declarations: HEALTHY, DEGRADED, or ERROR.
NEXT_PUBLIC_PROJECT_INTEGRATION_HEALTH=HEALTHY
NEXT_PUBLIC_COLLABORATION_INTEGRATION_HEALTH=HEALTHY
NEXT_PUBLIC_BUSINESS_INTEGRATION_HEALTH=HEALTHY
NEXT_PUBLIC_CLAIM_AI_INTEGRATION_HEALTH=HEALTHY

# Public URL only. Never put an OCR secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_BUSINESS_CARD_OCR_ENDPOINT=http://localhost:8787/ocr/business-card

# Server-side variables for tools/business-card-ocr-gateway.mjs
OCR_PROVIDER=clova
CLOVA_OCR_INVOKE_URL=https://YOUR-ID.apigw.ntruss.com/custom/v1/YOUR-DOMAIN/YOUR-KEY/document/name-card
CLOVA_OCR_SECRET=replace-on-server-only
OCR_ALLOWED_ORIGIN=http://localhost:3000
OCR_GATEWAY_PORT=8787
